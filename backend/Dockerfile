dockerfile<br>FROM python:3.11-slim<br><br># Install system deps (FFmpeg, libs for Whisper/OpenCV)<br>RUN apt-get update && apt-get install -y \\<br>    ffmpeg \\<br>    libsm6 \\<br>    libxext6 \\<br>    && rm -rf /var/lib/apt/lists/*<br><br># Copy & install Python deps<br>WORKDIR /app<br>COPY backend/requirements.txt .<br>RUN pip install --no-cache-dir -r requirements.txt<br><br># Copy app code<br>COPY backend/ .<br><br># Expose port<br>EXPOSE 8000<br><br># Run server<br>CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]<br>
